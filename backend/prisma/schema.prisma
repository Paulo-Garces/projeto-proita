generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String         @id @default(uuid())
  nome                       String
  sobrenome                  String?
  telefone                   String?        @unique
  senha                      String?
  bairro                     String?
  role                       String         @default("USER")
  createdAt                  DateTime       @default(now())
  profileImageFileId         String?
  profileImageUrl            String?
  cep                        String?
  isWhatsapp                 Boolean        @default(false)
  email                      String?        @unique
  googleId                   String?        @unique
  resetCode                  String?
  resetCodeExpires           DateTime?
  emailSecundario            String?
  emailSecundarioCode        String?
  emailSecundarioCodeExpires DateTime?
  emailSecundarioVerificado  Boolean        @default(false)
  telefoneCodigo             String?
  telefoneCodigoExpires      DateTime?
  telefoneVerificado         Boolean        @default(false)
  planStatus                 String         @default("INATIVO")
  subscriptionEndsAt         DateTime?
  trialEndsAt                DateTime?
  cpfCnpj                    String?
  pendingNossoNumero         String?        @unique
  pendingPlanId              String?
  pendingTxid                String?        @unique
  adminNotes                 String?
  planType                   String?
  NfeRequest                 NfeRequest[]
  notifications              Notification[]
  profiles                   Profile[]
  reviews                    Review[]
  favoriteProfiles           Profile[]      @relation("UserFavorites")
  phones                     UserPhone[]
}

model UserPhone {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  numero      String
  isVerified  Boolean   @default(false)
  codigoOtp   String?
  otpExpires  DateTime?
  createdAt   DateTime  @default(now())
}

model Profile {
  id                          String    @id @default(uuid())
  userId                      String
  atividadePrincipal          String
  atividadesSecundarias       String[]
  descricaoTrabalho           String
  redesSociais                Json?
  createdAt                   DateTime  @default(now())
  avatarFileId                String?
  avatarUrl                   String?
  endereco                    String?
  instagram                   String?
  portfolioUrls               String[]
  whatsapp                    String?
  serviceBairro               String?
  servicePhone                String?
  socialLinks                 Json?
  cliquesWhatsapp             Int       @default(0)
  visitasPerfil               Int       @default(0)
  bairroEndereco              String?
  categoriaGeral              String?
  descricaoCurta              String?
  exibirEnderecoCompleto      Boolean   @default(true)
  nomeExibicao                String?
  sobrenomeExibicao           String?
  rating                      Float?    @default(0)
  reviewCount                 Int       @default(0)
  fotoAnuncioFileId           String?
  fotoAnuncioUrl              String?
  telefoneComercial           String?
  telefoneComercialVerificado Boolean   @default(false)
  capaFileId                  String?
  capaUrl                     String?
  enderecoComercial           String?
  horariosFuncionamento       Json?
  impressions                 Int       @default(0)
  phoneClicks                 Int       @default(0)
  profileViews                Int       @default(0)
  shares                      Int       @default(0)
  whatsappClicks              Int       @default(0)
  partners                    Json?
  lastNamePhoneUpdate         DateTime? @map("last_name_phone_update")
  referenceCode               String?   @unique
  slug                        String?   @unique
  user                        User      @relation(fields: [userId], references: [id])
  reports                     Report[]
  reviews                     Review[]
  services                    Service[]
  favoritedBy                 User[]    @relation("UserFavorites")
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(uuid())
  name       String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
}

model SearchHistory {
  id        String   @id @default(uuid())
  query     String   @unique
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  profileId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  authorId  String
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  profile   Profile  @relation(fields: [profileId], references: [id])
}

model Service {
  id          String   @id @default(uuid())
  name        String
  priceType   String
  price       Float?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id])
}

model Report {
  id             String   @id @default(uuid())
  adId           String
  reason         String
  details        String?
  reporterUserId String?
  status         String   @default("pendente")
  createdAt      DateTime @default(now())
  ad             Profile  @relation(fields: [adId], references: [id], onDelete: Cascade)
}

model NfeRequest {
  id        String   @id
  userId    String
  email     String
  status    String   @default("PENDENTE")
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model mural_oportunidades {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String    @db.VarChar(255)
  description    String
  category       String    @db.VarChar(100)
  source_name    String    @db.VarChar(150)
  source_url     String?
  published_date DateTime  @db.Timestamptz(6)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  @@index([category], map: "idx_mural_category")
  @@index([published_date(sort: Desc)], map: "idx_mural_published_date")
}
