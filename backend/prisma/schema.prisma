generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  nome                String
  sobrenome           String
  telefone            String    @unique
  senha               String
  bairro              String?
  cep                 String?
  isWhatsapp          Boolean   @default(false)
  role                String    @default("USER")
  profileImageUrl     String?
  profileImageFileId  String?
  createdAt           DateTime  @default(now())
  profiles            Profile[] // 1:N — um usuário pode ter vários anúncios
}

model Profile {
  id                    String   @id @default(uuid())
  userId                String   
  user                  User     @relation(fields: [userId], references: [id])
  
  // Nomenclatura oficial do MEI e IA
  atividadePrincipal    String   // Ex: Encanador, Vaqueiro, Digital Maker
  categoriaGeral        String?  // Ex: "Construção e Reformas" (Nova Trava)
  atividadesSecundarias String[]
  
  descricaoTrabalho     String
  descricaoCurta        String?  // CORRIGIDO: Estava shortDescription. Max 90 chars.

  // Contato e Redes Sociais
  instagram             String?
  whatsapp              String?
  servicePhone          String?
  
  // Localização
  endereco              String?
  serviceBairro         String?
  
  // Portfólio e Imagens
  portfolioUrls         String[]
  avatarUrl             String?
  avatarFileId          String?
  
  // Campos Legado e Métricas
  redesSociais          Json?
  socialLinks           Json?
  cliquesWhatsapp       Int       @default(0)
  visitasPerfil         Int       @default(0)
  createdAt             DateTime  @default(now())
}

// Tabelas fixas para alimentar os Menus de Busca/Filtro do Frontend
model Category {
  id            String         @id @default(uuid())
  name          String         @unique
  subcategories Subcategory[]
}

model Subcategory {
  id          String    @id @default(uuid())
  name        String    @unique
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
}

model SearchHistory {
  id        String   @id @default(uuid())
  query     String   @unique
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}